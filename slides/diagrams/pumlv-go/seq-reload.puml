@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName "Noto Sans JP"
skinparam sequence {
  ArrowColor #3a4046
  LifeLineBorderColor #c4ccd0
  ParticipantBorderColor #0a7c98
  ActorBorderColor #0a7c98
}

actor 開発者 as dev
participant "pumlv (Go)" as go
participant "ブラウザ (SPA)" as spa
participant "plantuml.js" as pjs

dev -> go : seq.puml を保存（fsnotify が検知）
activate go
go -> go : 100ms デバウンス
go --> spa : event: changed
deactivate go
spa -> go : GET /api/file?path=...
go --> spa : PlantUML ソース
spa -> pjs : renderToString(ソース)
pjs --> spa : SVG
spa -> dev : 再描画された図
@enduml
