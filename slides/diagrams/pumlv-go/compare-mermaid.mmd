classDiagram
    class ユーザ {
        +id
        +name
    }
    class プロフィール {
        +bio
    }
    class 記事 {
        +id
        +title
        +body
    }
    class コメント {
        +id
        +body
    }
    class カテゴリ {
        +name
    }
    class タグ {
        +name
    }
    class 画像 {
        +url
    }
    class いいね {
        +created_at
    }

    ユーザ "1" -- "0..1" プロフィール
    ユーザ "1" -- "0..*" 記事
    ユーザ "1" -- "0..*" コメント
    記事 "1" -- "0..*" コメント
    記事 "1" -- "0..*" 画像
    記事 "*" -- "1" カテゴリ
    記事 "*" -- "*" タグ
    記事 "1" -- "0..*" いいね
    ユーザ "1" -- "0..*" いいね
